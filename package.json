{
  "name": "apolena",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "sh -c 'set -a && [ -f .env.local ] && . ./.env.local; set +a && prisma db push'",
    "db:seed": "sh -c 'set -a && [ -f .env.local ] && . ./.env.local; set +a && npx --yes tsx prisma/seed.ts'",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write ."
  },
  "dependencies": {
    "@fal-ai/serverless-client": "^0.14.0",
    "@prisma/client": "6.7.0",
    "@supabase/supabase-js": "^2.45.6",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "prisma": "6.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "swiper": "^14.4.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
