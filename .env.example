# ═══════════════════════════════════════════════════════════════════════
# 1. BASE DE DATOS (SUPABASE POSTGRESQL + PRISMA ORM)
# ═══════════════════════════════════════════════════════════════════════
# Copia la cadena de conexión desde Supabase -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ═══════════════════════════════════════════════════════════════════════
# 2. SUPABASE STORAGE & CLIENT
# ═══════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ═══════════════════════════════════════════════════════════════════════
# 3. AUTENTICACIÓN Y SEGURIDAD RBAC (PRISMA SESSION)
# ═══════════════════════════════════════════════════════════════════════
AUTH_SECRET="apolena-secret-key-production-change-me-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 directo en apolena.shop (evita mostrar *.supabase.co en Google)
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ═══════════════════════════════════════════════════════════════════════
# 4. CORREOS TRANSACCIONALES (RESEND — email_queue & CRON WORKER)
# ═══════════════════════════════════════════════════════════════════════
# Si está vacío, los correos se guardan en la tabla email_queue en modo simulación.
# Al colocar tu RESEND_API_KEY, se enviarán automáticamente al comprador y administradores.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Apolena <notificaciones@apolena.shop>"
# Token secreto para proteger el endpoint del worker / cron (/api/cron/email-worker)
CRON_SECRET="apolena-cron-secret-change-me-2026"

# ═══════════════════════════════════════════════════════════════════════
# 5. MOTORES DE IA PARA FUSIÓN DE RETRATOS DE MASCOTAS
# ═══════════════════════════════════════════════════════════════════════
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY="AIzaSy..."
FAL_KEY=""

# ═══════════════════════════════════════════════════════════════════════
# 6. GOOGLE TAG MANAGER (GTM) & GOOGLE ANALYTICS 4 (GA4)
# ═══════════════════════════════════════════════════════════════════════
# Contenedor GTM principal (por defecto usa GTM-54JPQQK2)
NEXT_PUBLIC_GTM_ID="GTM-54JPQQK2"
# Measurement ID de GA4 para Apolena Web (por defecto usa G-QK22TGKT0M)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-QK22TGKT0M"

# ═══════════════════════════════════════════════════════════════════════
# 7. COBERTURA GEOGRÁFICA (PAÍSES HABILITADOS)
# ═══════════════════════════════════════════════════════════════════════
# Códigos ISO-2 separados por coma. Por defecto solo Perú ("PE").
# Para abrir nuevos países en el futuro: ej. "PE,CO,CL,MX"
NEXT_PUBLIC_ACTIVE_COUNTRIES="PE"

# ═══════════════════════════════════════════════════════════════════════
# 8. LIMPIEZA AUTOMÁTICA DE RETRATOS NO COMPRADOS (CRON DIARIO)
# ═══════════════════════════════════════════════════════════════════════
# Días de retención antes de eliminar generation_jobs sin orden asociada y sus archivos en Storage
UNPURCHASED_JOB_RETENTION_DAYS="30"
