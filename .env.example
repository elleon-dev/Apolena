# ═══════════════════════════════════════════════════════════════════════
# 1. BASE DE DATOS (SUPABASE POSTGRESQL + PRISMA ORM)
# ═══════════════════════════════════════════════════════════════════════
# Copia la cadena de conexión desde Supabase -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ═══════════════════════════════════════════════════════════════════════
# 2. SUPABASE STORAGE & CLIENT
# ═══════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ═══════════════════════════════════════════════════════════════════════
# 3. AUTENTICACIÓN Y SEGURIDAD RBAC (PRISMA SESSION)
# ═══════════════════════════════════════════════════════════════════════
AUTH_SECRET="apolena-secret-key-production-change-me-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ═══════════════════════════════════════════════════════════════════════
# 4. CORREOS TRANSACCIONALES (RESEND — email_queue & CRON WORKER)
# ═══════════════════════════════════════════════════════════════════════
# Si está vacío, los correos se guardan en la tabla email_queue en modo simulación.
# Al colocar tu RESEND_API_KEY, se enviarán automáticamente al comprador y administradores.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Apolena Atelier <notificaciones@tudominio.com>"
# Token secreto para proteger el endpoint del worker / cron (/api/cron/email-worker)
CRON_SECRET="apolena-cron-secret-change-me-2026"

# ═══════════════════════════════════════════════════════════════════════
# 5. MOTORES DE IA PARA FUSIÓN DE RETRATOS DE MASCOTAS
# ═══════════════════════════════════════════════════════════════════════
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY="AIzaSy..."
FAL_KEY=""
